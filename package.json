{
  "name": "mandarin-ladder",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, levelled Mandarin course for Indonesian speakers, from zero to HSK 9.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run data:check && npm run content:check",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "data:fetch": "tsx scripts/data-fetch.ts",
    "data:import": "tsx scripts/data-import.ts",
    "data:check": "tsx scripts/data-check.ts",
    "content:check": "tsx scripts/content-check.ts",
    "audio:list": "tsx scripts/audio-list.ts",
    "audio:ingest": "tsx scripts/audio-ingest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.18.12",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "eslint-config-prettier": "9.1.2",
    "gray-matter": "4.0.3",
    "js-yaml": "4.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  }
}
